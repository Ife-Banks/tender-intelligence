# Copy to .env and fill in. Never commit .env.

# Shared relational database (production target: PostgreSQL)
TI_DATABASE_URL=postgresql+psycopg://tender:tender@localhost:5432/tender_intelligence

# Encryption master key for secrets-at-rest. MUST live outside the database.
# Generate with:  python -m tender_intelligence.crypto generate-key
# Format: base64-encoded 32 random bytes.
TI_MASTER_KEY=

# Bootstrap: first dev-alert recipient (seeded on first run if the list is empty).
TI_DEV_ALERT_EMAIL=

# Logging
TI_LOG_LEVEL=INFO

# Document storage root (local filesystem implementation; production backend is an open decision)
TI_STORAGE_DIR=./data/documents