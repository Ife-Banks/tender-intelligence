# Copy to .env and fill in. The worker, admin app, and alembic all read these.

# SQLite (no Docker):  sqlite+pysqlite:///./data/dev.db
# Neon (serverless Postgres): postgresql+psycopg://USER:PASSWORD@HOST.neon.tech/DB?sslmode=require
# Local Postgres:     postgresql+psycopg://tender:tender@localhost:5432/tender_intelligence
TI_DATABASE_URL=sqlite+pysqlite:///./data/dev.db

# Required for encrypting secrets at rest.
# Generate with: uv run python -m tender_intelligence.crypto generate-key
TI_MASTER_KEY=

# Optional
TI_LOG_LEVEL=INFO
TI_DEV_ALERT_EMAIL=
TI_STORAGE_DIR=./data/documents
# Optional dedicated HMAC key and archive origin for signed expiring document links.
# Leave the signing key empty to use TI_MASTER_KEY; the archive host is an open deployment decision.
TI_LINK_SIGNING_SECRET=
TI_LINK_BASE_URL=https://archive.example.invalid

# Admin API: production stays fail-closed until the O11 authentication integration is chosen.
# Test header authentication is only for isolated local/test execution.
TI_ENV=development
TI_ADMIN_ENABLE_TEST_AUTH=false

# [PROPOSED technical guard] Maximum decoded Admin KB upload size (20 MiB).
TI_ADMIN_MAX_KB_UPLOAD_BYTES=20971520
